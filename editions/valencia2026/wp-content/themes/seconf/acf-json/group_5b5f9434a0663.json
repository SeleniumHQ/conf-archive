            "message": "<em>For use in buttons or CSS classes such as text-white, link-<\/em><br><br>\r\n<svg class=\"clone-color-bar\"><rect fill=\"#001649\"><\/rect><\/svg>&nbsp;&nbsp;bluedark #001649\r\n<svg class=\"clone-color-bar\"><rect fill=\"#0572ED\"><\/rect><\/svg>&nbsp;&nbsp;blue #0572ED\r\n<svg class=\"clone-color-bar\"><rect fill=\"#5CFAFF\"><\/rect><\/svg>&nbsp;&nbsp;bluebright #5CFAFF\r\n<svg class=\"clone-color-bar\"><rect fill=\"#000000\"><\/rect><\/svg>&nbsp;&nbsp;black #000000\r\n<svg class=\"clone-color-bar\"><rect fill=\"#707070\"><\/rect><\/svg>&nbsp;&nbsp;gray75 #707070\r\n<svg class=\"clone-color-bar\"><rect fill=\"#BFBFBF\"><\/rect><\/svg>&nbsp;&nbsp;gray50 #BFBFBF\r\n<svg class=\"clone-color-bar\"><rect fill=\"#EFEFEF\"><\/rect><\/svg>&nbsp;&nbsp;gray25 #EFEFEF\r\n<svg class=\"clone-color-bar\"><rect fill=\"#F8F7F7\"><\/rect><\/svg>&nbsp;&nbsp;gray10 #F8F7F7\r\n<svg class=\"clone-color-bar\" style=\"border: solid #C6C6C6 1px;\"><rect fill=\"#FFFFFF\"><\/rect><\/svg>&nbsp;&nbsp;white #FFFFFF",
